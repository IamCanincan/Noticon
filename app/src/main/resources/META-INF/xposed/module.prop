id=com.iamcanincan.noticon
name=Noticon
version=1.0
versionCode=1
description=Replace notification small icons that lack theming support with the app's own launcher icon and keep the original colors. Icons that are already monochrome are left untouched. Runs in the background with no launcher entry and no configuration, scoped to SystemUI only. The Chinese description shown in the manager comes from the xposeddescription resource.
author=IamCanincan
minApiVersion=102
targetApiVersion=102
autoHotReload=true
exceptionMode=protective
