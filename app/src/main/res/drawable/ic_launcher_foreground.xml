<?xml version="1.0" encoding="utf-8"?>
<!--
    仿 Mihon 风格图标：粉环 + 黑色字符 N。

    Mihon 原版结构（432 视口）：
      background = 白底 + 淡蓝圆 #F2FAFF + 蓝色圆环 #0058A0（evenOdd 挖空）
      foreground = 黑色字符 M #031019
    本版改成：
      圆环改成樱粉 #F9A8C4，底色淡粉 #FDF2F6
      字符从 Google Sans Flex Bold 提取 "N"（替代 Mihon 的手绘 M），颜色保持 #031019

    几何（视口 108，中心 (54,54)）：
      圆环：外 R=30，内 r=25.5，环宽 4.5（外径 60 < 安全圈 66 ✓）
      底色圆：R=30（与环外径一致）
      字符：高 26（占内圆直径 51%），居中
      最远点 30.00 ≤ 33 安全圈 ✓

    渲染规则：环用 fillType="evenOdd" 挖空，底圆和字符用 nonzero 填充并集。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 淡粉底圆（与环外径一致） -->
    <path android:fillColor="#FDF2F6"
          android:pathData="M54,24 A30,30 0 0 1 54,84 A30,30 0 0 1 54,24 Z" />

    <!-- 2. 樱粉圆环（evenOdd 挖空） -->
    <path android:fillColor="#F9A8C4"
          android:fillType="evenOdd"
          android:pathData="M54,24 A30,30 0 0 1 54,84 A30,30 0 0 1 54,24 Z M54,28.5 A25.5,25.5 0 0 1 54,79.5 A25.5,25.5 0 0 1 54,28.5 Z" />

