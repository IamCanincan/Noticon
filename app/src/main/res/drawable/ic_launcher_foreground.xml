<?xml version="1.0" encoding="utf-8"?>
<!--
    图形语意：一条通知 —— 卡片里左边是那个小图标、右边是文字。
    卡片的圆点和文字线用 primary-container 色（和背景同色），
    看起来像在卡片上「挖」出来的，比另配一个前景色更整。

    颜色全部取自 Material 3 baseline：
      primary             #6750A4
      primary-container   #EADDFF
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 通知卡片 -->
    <path
        android:fillColor="#6750A4"
        android:pathData="M40,36 L68,36 A10,10 0 0 1 78,46 L78,62 A10,10 0 0 1 68,72 L40,72 A10,10 0 0 1 30,62 L30,46 A10,10 0 0 1 40,36 Z" />

    <!-- 卡片里的通知小图标 -->
    <path
        android:fillColor="#EADDFF"
        android:pathData="M46,46 a8,8 0 0 1 0,16 a8,8 0 0 1 0,-16 z" />

    <!-- 通知文字：两条不等长的短线 -->
    <path
        android:fillColor="#EADDFF"
        android:pathData="M60,48 h14 a2,2 0 0 1 0,4 h-14 a2,2 0 0 1 0,-4 z" />
    <path
        android:fillColor="#EADDFF"
        android:pathData="M60,56 h10 a2,2 0 0 1 0,4 h-10 a2,2 0 0 1 0,-4 z" />
</vector>
