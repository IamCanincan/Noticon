<?xml version="1.0" encoding="utf-8"?>
<!--
    消息气泡被横竖切成四份。

    设计：
      一个圆角矩形消息气泡（左下带圆润尾巴），被横竖各切一刀分成 4 块，
      块与块之间留 4 单位间隙（分离），4 块分别填 Google 四色。
      所有尖角都圆角化：
        - 气泡外轮廓的 4 个圆角 r=9（保持原"气泡"的圆润）
        - 切口产生的 12 个直角 r=2（小圆角，块仍像矩形）

    几何（视口 108）：
      气泡外框 x 32..76, y 26..66
      切口中心 (54, 46)，gap=4
      四色按 Google 经典 2x2 排布：左上蓝 / 右上红 / 右下绿 / 左下黄
      尾巴：从 BL 块底边 (46,66) 经两段贝塞尔到尖端 (34,76)，再回左边
      两段贝塞尔在尖端 G1 连续（切线同向），尖端自然圆润无尖点
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左上 蓝 -->
    <path android:fillColor="#4285F4"
          android:pathData="M32,46 L32,35 A9,9 0 0 1 41,26 L50,26 A2,2 0 0 1 52,28 L52,42 A2,2 0 0 1 50,44 L34,44 A2,2 0 0 1 32,46 Z" />

    <!-- 右上 红 -->
    <path android:fillColor="#EA4335"
          android:pathData="M56,28 A2,2 0 0 1 58,26 L67,26 A9,9 0 0 1 76,35 L76,42 A2,2 0 0 1 74,44 L56,44 L56,28 Z" />

    <!-- 右下 绿 -->
    <path android:fillColor="#34A853"
          android:pathData="M56,48 L74,48 A2,2 0 0 1 76,50 L76,57 A9,9 0 0 1 67,66 L58,66 A2,2 0 0 1 56,64 L56,48 Z" />

    <!-- 左下 黄（含尾巴） -->
    <path android:fillColor="#FBBC05"
          android:pathData="M34,44 L56,44 L56,64 A2,2 0 0 1 54,66 L46,66 C42,66 36,72 34,76 C33,79 32,75 32,72 L32,46 L34,44 Z" />
</vector>