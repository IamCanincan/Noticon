<?xml version="1.0" encoding="utf-8"?>
<!--
    四色圆环：Google 品牌四色 蓝 / 红 / 黄 / 绿 各占一段 82 度圆弧，
    段与段之间留 8 度缺口，中心挖空，整体是一个环。

    上一版是四片从中心发散的风车，四片在圆心汇聚成尖角，小尺寸下又硬又乱。
    这版改成圆环段：没有尖角、没有汇聚点，每一处边界都是圆弧，
    缩到状态栏那么小也只剩几段圆润的色块，不会糊成一团。

    几何：圆心 (54,54)，外圆 r=31、内圆 r=12，段占 4°~86°。
    r=31 在自适应图标 66dp 安全圈（半径 33）以内，不会被裁。
    四段由同一条 pathData 旋转 0 / 90 / 180 / 270 得到，改形状只需改一处。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <path
            android:fillColor="#4285F4"
            android:pathData="M56.16,23.07 A31,31 0 0 1 84.93,51.84 L65.97,53.16 A12,12 0 0 0 54.84,42.03 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="90">
        <path
            android:fillColor="#EA4335"
            android:pathData="M56.16,23.07 A31,31 0 0 1 84.93,51.84 L65.97,53.16 A12,12 0 0 0 54.84,42.03 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="180">
        <path
            android:fillColor="#FBBC05"
            android:pathData="M56.16,23.07 A31,31 0 0 1 84.93,51.84 L65.97,53.16 A12,12 0 0 0 54.84,42.03 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="270">
        <path
            android:fillColor="#34A853"
            android:pathData="M56.16,23.07 A31,31 0 0 1 84.93,51.84 L65.97,53.16 A12,12 0 0 0 54.84,42.03 Z" />
    </group>
</vector>
