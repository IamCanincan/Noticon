<!--
    消息气泡被横竖切成 4 份 —— 三七分 + 整体居中。

    设计：
      圆角矩形消息气泡（左下带圆润尾巴），横竖各切一刀分成 4 块。
      切口在 30% 处（左/上 = 3，右/下 = 7），四块大小不等形成设计节奏：
        左上 10x10 / 右上 26x10 / 左下 10x26 / 右下 26x26
      块与块之间留 4 单位间隙（相互分离）。
      所有尖角圆角化：气泡外角 r=4，切口产生的直角 r=2。

    居中：
      气泡 x 34..74（中心 54 ✓）
      气泡 y 29..69，尾巴延伸到 79 → 含尾巴 y 29..79（中心 54 ✓）

    几何（视口 108）：
      气泡外框 x 34..74, y 29..69
      切口 (46, 41)，gap=4
      四色 Google 经典 2x2：左上蓝 / 右上红 / 右下绿 / 左下黄
      尾巴两段贝塞尔在尖端 G1 连续（切线同向），尖端自然圆润
      所有顶点距画布中心 (54,54) ≤ 33（实测最远 32.65）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左上 蓝（最小块） -->
    <path android:fillColor="#4285F4"
          android:pathData="M34,42 L34,34 A4,4 0 0 1 38,30 L42,30 A2,2 0 0 1 44,32 L44,38 A2,2 0 0 1 42,40 L36,40 A2,2 0 0 1 34,42 Z" />

    <!-- 右上 红 -->
    <path android:fillColor="#EA4335"
          android:pathData="M48,32 A2,2 0 0 1 50,30 L70,30 A4,4 0 0 1 74,34 L74,38 A2,2 0 0 1 72,40 L48,40 L48,32 Z" />

    <!-- 右下 绿（最大块） -->
    <path android:fillColor="#34A853"
          android:pathData="M48,44 L72,44 A2,2 0 0 1 74,46 L74,66 A4,4 0 0 1 70,70 L50,70 A2,2 0 0 1 48,68 L48,44 Z" />

    <!-- 左下 黄（含尾巴） -->
    <path android:fillColor="#FBBC05"
          android:pathData="M36,40 L44,40 L44,68 A2,2 0 0 1 42,70 L40,70 C38,71 36,73 34,77 C33,79 34,76 34,74 L34,42 L36,40 Z" />
</vector>
