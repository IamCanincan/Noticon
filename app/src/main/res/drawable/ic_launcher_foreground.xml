<?xml version="1.0" encoding="utf-8"?>
<!--
    零锐角设计要点：

    1) 铃铛轮廓是 4 段贝塞尔 + 1 段直线封闭路径，
       每个节点的「入切线」都等于「出切线」（切线连续 / G1 连续）。
       整个轮廓上看不到任何折角。

       几何（视口 108，已按 y+2 整体平移让垂直居中）：
         顶 半圆 r=15 圆心 (54,43)，两段三次贝塞尔近似
         侧 (69,41)→C(69,56)→C(80,77)→(74,77)  出切线 (-6,0) 水平向左
         底 (74,77)→(34,77)                       直线
         侧 (34,77)→C(28,77)→C(39,58)→(39,43)   入切线 (-6,0) 水平向左
         （与右侧切线方向一致 —— 切线连续）

    2) 钟身内部的白色「铃舌」是一个圆（坐标 (54,70) r=5.5）。
       圆本身全是弧线，没有顶点。它被四色带包围，自然醒目。

    3) 通知角标：白色圆盘 (61,51) r=6.5 + 红点 r=4。
       完全落在钟身内部，叠画不挖空（挖空在两子路径相交处必然产生尖点，
       上一版「丑」的根源）。

    4) 四色斜带：s = 0.5·(x-54) + 0.866·(y-54)，相邻带子无缝拼接
       （边界 s = -11 / -1 / 9），没有白色缝隙，整体感强。
       用 <clip-path> 把 4 条大色带裁到钟身形状内。

    所有顶点距画布中心 (54,54) 都在 33 以内，落进自适应图标的 66dp 安全圈。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 钟身形状作为剪裁区，所有色带被裁到钟身内部 -->
    <clip-path
        android:pathData="M39,43 C39,35.72 45.72,29 54,29 C62.28,29 69,35.72 69,43 C69,58 80,77 74,77 L34,77 C28,77 39,58 39,43 Z" />

    <!-- 四色斜带（沿 s 轴方向切片），相邻带子无缝拼接 -->
    <path android:fillColor="#4285F4"
          android:pathData="M0,0 L108,0 L108,10.16 L0,72.5 Z" />
    <path android:fillColor="#EA4335"
          android:pathData="M0,72.5 L108,10.16 L108,21.7 L0,84.06 Z" />
    <path android:fillColor="#FBBC05"
          android:pathData="M0,84.06 L108,21.7 L108,33.22 L0,95.61 Z" />
    <path android:fillColor="#34A853"
          android:pathData="M0,95.61 L108,33.22 L108,108 L0,108 Z" />

    <!-- 钟身内部的白色铃舌（圆本身就是弧线） -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M54,64.5 A5.5,5.5 0 1,0 54,75.5 A5.5,5.5 0 1,0 54,64.5 Z" />

    <!-- 通知角标：白盘 + 红点，完全落在钟身内部（叠画不挖空） -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M54.5,51 A6.5,6.5 0 1,0 67.5,51 A6.5,6.5 0 1,0 54.5,51 Z" />
    <path android:fillColor="#EA4335"
          android:pathData="M57,51 A4,4 0 1,0 65,51 A4,4 0 1,0 57,51 Z" />
</vector>