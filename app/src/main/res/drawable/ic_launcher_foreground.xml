<!--
    消息气泡被横竖切成 4 份 —— 三七分 + 竖长方形 + 居中 + 宽间隙。

    设计：
      圆角竖长方形消息气泡（左下带圆润尾巴），横竖各切一刀分成 4 块。

      · 三七分：切口在 30% 处（左/上 = 3，右/下 = 7），四块大小不等形成设计节奏：
          左上 7x10 / 右上 19x10 / 左下 7x28+尾 / 右下 19x28
      · 长宽比加大：气泡 32 宽 x 44 高 = 1.38（上一版是 40x40 = 1.00）
      · 整体缩小：面积 1408（上一版 1600，小 12%）
      · 居中：长方形中心 (54, 54) 严格 = 圆心 = 画布中心
      · 色块分开：切口间隙 GAP=6（上一版 4 太细，蓝/黄看起来粘连）

    几何（视口 108）：
      气泡外框 x 38..70, y 32..76
      切口 (48, 45)，gap=6
      四色 Google 经典 2x2：左上蓝 / 右上红 / 右下绿 / 左下黄
      尾巴两段贝塞尔在尖端 G1 连续（共享切线 d=(-1,1)），尖端自然圆润
      所有顶点距画布中心 (54,54) <= 33（实测最远 32.65）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左上 蓝（最小块 7x10） -->
    <path android:fillColor="#4285F4"
          android:pathData="M38,44 L38,35 A3,3 0 0 1 41,32 L43,32 A2,2 0 0 1 45,34 L45,40 A2,2 0 0 1 43,42 L40,42 A2,2 0 0 1 38,44 Z" />

    <!-- 右上 红（19x10） -->
    <path android:fillColor="#EA4335"
          android:pathData="M51,34 A2,2 0 0 1 53,32 L67,32 A3,3 0 0 1 70,35 L70,40 A2,2 0 0 1 68,42 L51,42 L51,34 Z" />

    <!-- 右下 绿（最大块 19x28） -->
    <path android:fillColor="#34A853"
          android:pathData="M51,48 L68,48 A2,2 0 0 1 70,50 L70,73 A3,3 0 0 1 67,76 L53,76 A2,2 0 0 1 51,74 L51,48 Z" />

    <!-- 左下 黄（7x28，含尾巴） -->
    <path android:fillColor="#FBBC05"
          android:pathData="M40,48 L43,48 A2,2 0 0 1 45,50 L45,76 C45,77 42,80 40,82 C39,83 38,81 38,78 L38,50 A2,2 0 0 1 40,48 Z" />
</vector>
