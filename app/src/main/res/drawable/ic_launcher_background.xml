        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FFEADDFF" android:offset="0" />
                <item android:color="#FFD0BCFF" android:offset="1" />
