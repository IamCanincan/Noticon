<?xml version="1.0" encoding="utf-8"?>
<!--
    主题图标（Android 13+）用的单色版，形状与彩色版完全一致。

    系统只取 alpha 通道着色，颜色写什么都会被丢掉，所以四片用不同
    不透明度（100 / 75 / 50 / 35%）拉开层次 —— 否则四片连成一个整圆，
    看不出里面还有结构。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,54 L54,24 A30,30 0 0 1 84,54 C76,46 64,50 54,54 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="90">
        <path
            android:fillColor="#BFFFFFFF"
            android:pathData="M54,54 L54,24 A30,30 0 0 1 84,54 C76,46 64,50 54,54 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="180">
        <path
            android:fillColor="#80FFFFFF"
            android:pathData="M54,54 L54,24 A30,30 0 0 1 84,54 C76,46 64,50 54,54 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="270">
        <path
            android:fillColor="#59FFFFFF"
            android:pathData="M54,54 L54,24 A30,30 0 0 1 84,54 C76,46 64,50 54,54 Z" />
    </group>
</vector>
